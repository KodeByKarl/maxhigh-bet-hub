# MaxHigh — MariaDB / MySQL
# Copy to .env and fill in your credentials.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=maxhigh_app
MYSQL_PASSWORD=
MYSQL_DATABASE=maxhigh

# Or use a single URL instead of the MYSQL_* vars above:
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/maxhigh

# Seed accounts (npm run db:seed) — sign-in uses USERNAME
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_LOCAL_ADMIN_PASSWORD
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=REPLACE_WITH_DISTINCT_LOCAL_SUPERADMIN_PASSWORD
SEED_PLAYER_USERNAME=player1
SEED_PLAYER_PASSWORD=REPLACE_WITH_DISTINCT_LOCAL_PLAYER_PASSWORD

# Optional contact emails (not used for login)
# SEED_ADMIN_EMAIL=admin@maxhigh.gg
# SEED_SUPERADMIN_EMAIL=superadmin@maxhigh.gg
# SEED_PLAYER_EMAIL=player@maxhigh.gg

# --- Continuous auto-update (deploy/watcher.mjs + PM2) ---
# Polls GitHub and optionally accepts a push webhook so the server
# rebuilds itself when you push to main — no SSH needed for routine deploys.
DEPLOY_BRANCH=main
DEPLOY_POLL_SECONDS=60
DEPLOY_WEBHOOK_ENABLED=0
DEPLOY_WEBHOOK_PORT=9090
DEPLOY_WEBHOOK_SECRET=
DEPLOY_PM2_APP=maxhigh-app
# DEPLOY_DB_SYNC=1
# DEPLOY_INSTALL_CMD=npm ci
PORT=8080

# Public site (Caddy reverse proxy → PORT)
PUBLIC_URL=https://maxhigh.online
CADDY_DOMAIN=maxhigh.online
CADDY_ACME_EMAIL=admin@maxhigh.online

# App and updater must be reached through the local reverse proxy
HOST=127.0.0.1
DEPLOY_AUTO_APPLY=0
## Optional low-memory production profile (review deploy/profiles/ph-vps-2/README.md).
# DEPLOY_PROFILE=ph-vps-2
# OPERATION_COMPRESSION=0
# Enable compression only after two compatible reader releases are installed.
