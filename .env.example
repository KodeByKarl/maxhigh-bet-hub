# MaxHigh — MariaDB / MySQL
# Copy to .env and fill in your credentials.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=maxhigh

# Or use a single URL instead of the MYSQL_* vars above:
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/maxhigh

# Seed accounts (npm run db:seed) — sign-in uses USERNAME
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=super123
SEED_PLAYER_USERNAME=player1
SEED_PLAYER_PASSWORD=player123

# Optional contact emails (not used for login)
# SEED_ADMIN_EMAIL=admin@maxhigh.gg
# SEED_SUPERADMIN_EMAIL=superadmin@maxhigh.gg
# SEED_PLAYER_EMAIL=player@maxhigh.gg
