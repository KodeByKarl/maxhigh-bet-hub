# FUTURE REVIEW ONLY: no automatic installer consumes this file.
# Caddy adapt is syntax checking, not approval to run/reload this configuration.
# Keep Caddy inactive until production/HTTPS/DNS/proxy trust gates are approved.
maxhigh.online {
	encode zstd gzip
	@privateOps path /api/health /api/metrics
	respond @privateOps 404
	@sensitive path /api/* /_serverFn/* /admin* /superadmin*
	header @sensitive Cache-Control "private, no-store"
	@fingerprinted path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy 127.0.0.1:8080 {
		# Preserve Caddy's standard forwarded-header handling. Review trusted proxy
		# identity/Cloudflare separately; never trust an arbitrary incoming CF header.
		header_up -CF-Connecting-IP
	}
}
