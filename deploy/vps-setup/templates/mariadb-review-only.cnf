# REVIEW ONLY. Never copy into a live shared server without a separate measured plan.
# Only the explicitly approved fresh-host bootstrap may install this template.
# No durability setting is relaxed; never transplant it onto an unreviewed live DB.
[mariadb]
bind-address=127.0.0.1
innodb_buffer_pool_size=512M
max_connections=30
thread_cache_size=8
table_open_cache=400
tmp_table_size=8M
max_heap_table_size=8M
wait_timeout=120
innodb_flush_log_at_trx_commit=1
sync_binlog=1
# Binary-log enablement/server-id/retention require the approved recovery topology.
# Do not enable, disable, purge or reset existing binlogs using this template.
