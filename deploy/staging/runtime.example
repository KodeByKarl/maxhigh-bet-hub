# Install as /var/www/maxhigh-staging/.env, root:maxhigh-stage 0640.
# This is exclusively for a separate staging database. No production credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maxhigh_staging
MYSQL_USER=maxhigh_stage
MYSQL_PASSWORD=REPLACE_LOCALLY_WITH_STAGING_ONLY_SECRET
NODE_ENV=production
HOST=127.0.0.1
NITRO_HOST=127.0.0.1
PORT=18080
NITRO_PORT=18080
DEPLOY_CANDIDATE_PORT=18081
DEPLOY_PROFILE=ph-vps-2
DEPLOY_AUTO_APPLY=0
DEPLOY_WEBHOOK_ENABLED=0
DEPLOY_PM2_APP=maxhigh-app
OPERATION_COMPRESSION=0
APP_MAX_ACTIVE_REQUESTS=64
APP_DRAIN_TIMEOUT_MS=30000
DB_POOL_LIMIT=6
DB_POOL_QUEUE_LIMIT=30
DB_POOL_MAX_IDLE=3
# Access staging through a tunnel, with matching browser Origin/Host.
PUBLIC_URL=http://127.0.0.1:18080
